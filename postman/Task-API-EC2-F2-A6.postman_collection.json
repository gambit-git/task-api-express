{
  "info": {
    "name": "Task API EC2 F2 A6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "EC2 F2 A6 Persistencia",
      "item": [
        {
          "name": "01 Salud de la base de datos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/database"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"connected\", () => pm.expect(pm.response.json().database.status).to.eql(\"connected\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Crear tarea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Probar persistencia\",\"description\":\"Debe sobrevivir al reinicio\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json().data;",
                  "pm.collectionVariables.set(\"taskId\", t.id);",
                  "pm.test(\"id string de 24 caracteres\", () => pm.expect(t.id).to.match(/^[0-9a-f]{24}$/));",
                  "pm.test(\"sin _id ni __v\", () => { pm.expect(t).to.not.have.property(\"_id\"); pm.expect(t).to.not.have.property(\"__v\"); });",
                  "pm.test(\"pending\", () => pm.expect(t.status).to.eql(\"pending\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Listar tareas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Consultar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mismo id\", () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get(\"taskId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Completar tarea",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"completed\", () => pm.expect(pm.response.json().data.status).to.eql(\"completed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Consultar tras completar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"completed\", () => pm.expect(pm.response.json().data.status).to.eql(\"completed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Crear sin descripción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Sin descripción\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"sin description\", () => pm.expect(pm.response.json().data).to.not.have.property(\"description\"));",
                  "pm.collectionVariables.set(\"taskIdSinDescripcion\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Eliminar tarea",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Confirmar 404 final",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Código TASK_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"TASK_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Eliminar tarea sin descripción",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskIdSinDescripcion}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
