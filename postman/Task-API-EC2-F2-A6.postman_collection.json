                  "pm.test(\"Estado 415\", () => pm.response.to.have.status(415));",
                  "pm.test(\"Código UNSUPPORTED_MEDIA_TYPE\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNSUPPORTED_MEDIA_TYPE\"));"
