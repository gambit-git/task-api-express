                "body": {
                  "mode": "raw",
                  "raw": "{\"title\":\"Preparar evidencia del CRUD\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const responseBody = pm.response.json();",
                      "pm.collectionVariables.set(\"taskId\", responseBody.data.id);",
                      "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                      "pm.test(\"status pending\", () => pm.expect(responseBody.data.status).to.eql(\"pending\"));",
                      "pm.test(\"id de 24 hex\", () => pm.expect(responseBody.data.id).to.match(/^[0-9a-f]{24}$/));",
                      "pm.test(\"sin _id ni __v\", () => { const t = pm.response.json().data; pm.expect(t).to.not.have.property(\"_id\"); pm.expect(t).to.not.have.property(\"__v\"); });"
                    ]
                  }
                }
              ]
            },
