{
  "info": {
    "name": "Task API EC3 F1 A9",
    "description": "Ejecuta las carpetas en orden. P1 crea un usuario de prueba nuevo en cada ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "emailMixed", "value": "" },
    { "key": "password", "value": "" },
    { "key": "longPassword", "value": "" },
    { "key": "loginMessage", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "A. Salud y casos correctos",
      "item": [
        {
          "name": "00 Salud de la base de datos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/database"
          }
        },
        {
          "name": "P1 Registrar usuario (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36);",
                  "pm.collectionVariables.set('email', 'ana.torres.' + id + '@example.com');",
                  "pm.collectionVariables.set('emailMixed', 'ANA.Torres.' + id + '@Example.com');",
                  "pm.collectionVariables.set('password', 'Frase de prueba ' + id + ' ' + Math.random().toString(36).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Correo en minúsculas y rol user', () => {",
                  "  const user = pm.response.json().data.user;",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(user.role).to.eql('user');",
                  "});",
                  "pm.test('No expone contraseña ni hash', () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include('passwordHash');",
                  "  pm.expect(text).to.not.include('confirmPassword');",
                  "  pm.expect(text).to.not.include(pm.collectionVariables.get('password'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{emailMixed}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "P2 Iniciar sesión (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Entrega token Bearer con expiración', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.accessToken.split('.')).to.have.lengthOf(3);",
                  "  pm.expect(data.tokenType).to.eql('Bearer');",
                  "  pm.expect(data.expiresIn).to.be.a('string');",
                  "});",
                  "pm.test('No expone contraseña ni hash', () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include('passwordHash');",
                  "  pm.expect(text).to.not.include(pm.collectionVariables.get('password'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "B. Errores de registro",
      "item": [
        {
          "name": "N1 Correo repetido (409)",
          "event": [
