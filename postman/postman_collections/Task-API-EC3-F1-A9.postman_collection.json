                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((item) => item.field)).to.include('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
