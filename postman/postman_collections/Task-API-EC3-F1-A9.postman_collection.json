              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "N3 Contraseña de más de 72 bytes (422)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('longPassword', 'a'.repeat(73));"
