    },
    {
      "name": "D. Regresión de tareas (sin token)",
      "item": [
        {
          "name": "R1 Crear tarea (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('taskId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Probar A9\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "R2 Listar con paginación (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 con meta', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().meta.limit).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks?page=1&limit=5"
          }
        },
        {
          "name": "R3 Actualizar tarea (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Título actualizado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.title).to.eql('Probar A9 editada');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Probar A9 editada\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "R4 Completar tarea (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado completed', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('completed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
          }
        },
        {
          "name": "R5 Consulta combinada (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Solo completadas que contienen A9', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.length).to.be.above(0);",
                  "  data.forEach((task) => {",
                  "    pm.expect(task.status).to.eql('completed');",
                  "    pm.expect(task.title.toLowerCase()).to.include('a9');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks?status=completed&search=A9&sortBy=title&order=asc"
          }
        },
        {
          "name": "R6 Eliminar tarea (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204 sin cuerpo', () => {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "R7 Consultar tarea eliminada (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 TASK_NOT_FOUND con requestId', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('TASK_NOT_FOUND');",
                  "  pm.expect(pm.response.json().error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        }
      ]
    }
  ]
}
