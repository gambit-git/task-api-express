              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 en password', () => {",
                  "  pm.response.to.have.status(422);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((item) => item.field)).to.include('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{emailMixed}}\",\n  \"password\": \"{{longPassword}}\",\n  \"confirmPassword\": \"{{longPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "N4 Rol admin (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 en role', () => {",
                  "  pm.response.to.have.status(422);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((item) => item.field)).to.include('role');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{emailMixed}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"role\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "N5 Campo adicional (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 en edad', () => {",
                  "  pm.response.to.have.status(422);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((item) => item.field)).to.include('edad');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{emailMixed}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"edad\": 20\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "N6 confirmPassword distinta (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 en confirmPassword', () => {",
                  "  pm.response.to.have.status(422);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((item) => item.field)).to.include('confirmPassword');",
                  "});"
