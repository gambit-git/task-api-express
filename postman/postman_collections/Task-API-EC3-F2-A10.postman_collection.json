          "name": "23 Límite de intentos (429)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const options = {",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: '{}' },",
                  "};",
                  "for (let i = 0; i < 10; i += 1) pm.sendRequest(options, () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('429 AUTH_RATE_LIMIT_EXCEEDED', () => {",
                  "  pm.response.to.have.status(429);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTH_RATE_LIMIT_EXCEEDED');",
                  "  pm.expect(error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
