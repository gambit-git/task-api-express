{
  "info": {
    "name": "Task API EC3 F2 A10",
    "description": "Reinicia la API antes de empezar y ejecuta en orden. Antes de la petición 19 cambia el rol desde la terminal. La petición 23 agota el límite de autenticación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A. Rutas públicas",
      "item": [
        {
          "name": "01 Salud y cabeceras (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye X-Request-Id y cabeceras de Helmet', () => {",
                  "  pm.response.to.have.header('X-Request-Id');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "02 Registrar usuario (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36);",
                  "pm.collectionVariables.set('email', 'a10.' + id + '@example.com');",
                  "pm.collectionVariables.set('password', 'Frase de prueba ' + id + ' ' + Math.random().toString(36).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Rol user sin hash', () => {",
                  "  pm.expect(pm.response.json().data.user.role).to.eql('user');",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prueba A10\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Login como user (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token Bearer con rol user', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.tokenType).to.eql('Bearer');",
                  "  pm.expect(data.user.role).to.eql('user');",
                  "  pm.collectionVariables.set('userToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "B. Errores de autenticación",
      "item": [
        {
          "name": "04 Sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 AUTHENTICATION_REQUIRED', () => {",
                  "  pm.response.to.have.status(401);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('AUTHENTICATION_REQUIRED');",
                  "  pm.expect(error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "05 Token sin Bearer (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_AUTHORIZATION_HEADER', () => {",
                  "  pm.response.to.have.status(401);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('INVALID_AUTHORIZATION_HEADER');",
                  "  pm.expect(error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "06 Token inventado (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_TOKEN', () => {",
                  "  pm.response.to.have.status(401);",
                  "  const error = pm.response.json().error;",
                  "  pm.expect(error.code).to.eql('INVALID_TOKEN');",
                  "  pm.expect(error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token.invalido.firmado"
              }
            ],
            "url": "{{baseUrl}}/api/tasks"
          }
        }
      ]
    },
