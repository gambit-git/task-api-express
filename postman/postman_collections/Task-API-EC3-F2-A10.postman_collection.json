          "name": "21 CORS origen permitido (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Autoriza el origen', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              }
            ],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "22 CORS origen no permitido (200)",
          "event": [
